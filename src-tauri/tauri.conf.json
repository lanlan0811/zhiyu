{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "知屿 Zhīyǔ",
  "version": "0.1.0",
  "identifier": "com.zhiyu.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "知屿 Zhīyǔ",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perUser"
      }
    }
  },
  "plugins": {}
}
